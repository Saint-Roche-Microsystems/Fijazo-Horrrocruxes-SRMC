# Plantilla de las variables que TODOS los microservicios deben compartir para correr
#
# No se edita a mano para el día a día: `node scripts/bootstrap.mjs` genera
# `scripts/.env.shared` a partir de esta plantilla la primera vez (con secretos
# aleatorios vía crypto.randomBytes) y en las siguientes iteracciones REUTILIZA los valores
# ya generados ahí.

# Firma el JWT en auth-service, se valida en api-gateway. Mismo valor en ambos.
JWT_SECRET=change-me-in-production-please-use-a-secure-random-secret
JWT_ALGORITHM=HS256

# Autentica servicio-a-servicio en /internal/* de auth-service, users-service,
# bets-service y progression-service. Mismo valor en los cuatro: progression-service lo usa
# además como credencial SALIENTE al leer las apuestas de bets-service.
INTERNAL_API_KEY=change-me-internal-key

# DSN de los proyectos de Sentry (uno por stack). Vacío = SDK deshabilitado en esos
# servicios, no rompe el arranque local.
SENTRY_FASTAPI_DSN=use-your-sentry-project-dsn
SENTRY_NESTJS_DSN=use-your-sentry-project-dsn
